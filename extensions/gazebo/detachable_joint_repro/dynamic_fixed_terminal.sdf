<?xml version="1.0"?>
<!-- Same dynamic fixed-root control as dynamic_articulated.sdf, but the
     detachable parent is downstream of a preserved fixed joint.  RM75's
     gripper_mount_link has this exact topology. -->
<sdf version="1.10">
  <world name="detachable_dynamic_fixed_terminal_repro">
    <gravity>0 0 -9.81</gravity>
    <physics name="dartsim" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
    </link></model>

    <model name="fixed_terminal_parent">
      <pose>0 0 0.80 0 0 0</pose><self_collide>false</self_collide>
      <link name="base_link"><inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial></link>
      <joint name="world_to_base" type="fixed"><parent>world</parent><child>base_link</child></joint>
      <link name="wrist_link"><pose relative_to="base_link">0.20 0 0 0 0 0</pose>
        <inertial><mass>0.10</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      </link>
      <joint name="base_to_wrist" type="revolute"><parent>base_link</parent><child>wrist_link</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1</lower><upper>1</upper><effort>100</effort><velocity>2</velocity></limit></axis>
      </joint>
      <link name="mount_link"><pose relative_to="wrist_link">0.10 0 0 0 0 0</pose>
        <inertial><mass>0.01</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="mount_collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
      </link>
      <joint name="wrist_to_mount" type="fixed"><parent>wrist_link</parent><child>mount_link</child></joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>base_to_wrist</joint_name><topic>/repro/fixed_terminal/command</topic>
        <p_gain>30</p_gain><i_gain>0</i_gain><d_gain>2</d_gain><cmd_max>100</cmd_max><cmd_min>-100</cmd_min>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>mount_link</parent_link><child_model>fixed_terminal_child</child_model><child_link>child_link</child_link>
        <attach_topic>/repro/fixed_terminal/attach</attach_topic><detach_topic>/repro/fixed_terminal/detach</detach_topic>
        <output_topic>/repro/fixed_terminal/state</output_topic><suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </model>

    <model name="fixed_terminal_child"><pose>0.45 0 0.80 0 0 0</pose><link name="child_link">
      <inertial><mass>0.10</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="child_collision"><geometry><box><size>0.04 0.04 0.06</size></box></geometry></collision>
    </link></model>
  </world>
</sdf>
