<?xml version="1.0"?>
<!--
  Positive control for DetachableJoint.  The child starts clear of the parent;
  run.py drives three detach -> attach -> parent-motion -> detach cycles and
  decides from /world/.../pose/info, never from this plugin's state topic.
-->
<sdf version="1.10">
  <world name="detachable_single_link_repro">
    <gravity>0 0 -9.81</gravity>
    <physics name="dartsim" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
    </link></model>

    <model name="single_parent">
      <static>true</static><self_collide>false</self_collide>
      <pose>0 0 0.80 0 0 0</pose>
      <link name="parent_link"><collision name="parent_collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision></link>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>parent_link</parent_link>
        <child_model>single_child</child_model><child_link>child_link</child_link>
        <attach_topic>/repro/single/attach</attach_topic><detach_topic>/repro/single/detach</detach_topic>
        <output_topic>/repro/single/state</output_topic><suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </model>

    <model name="single_child"><pose>0.15 0 0.80 0 0 0</pose><link name="child_link">
      <inertial><mass>0.10</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="child_collision"><geometry><box><size>0.04 0.04 0.06</size></box></geometry></collision>
    </link></model>
  </world>
</sdf>
