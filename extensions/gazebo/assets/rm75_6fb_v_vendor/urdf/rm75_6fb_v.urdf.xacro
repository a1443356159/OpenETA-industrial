  <!-- Keep the manufacturer's physical wrist-camera mounting datum and mesh.
       The full-length arm is pitched toward the tool tip below.  This keeps
       the optical ray clear of the wrist and gripper body; shortening this
       arm makes their fixed self-occlusion dominate every eye-in-hand view. -->
  <link name="wrist_camera_bracket_link">
    <inertial>
      <origin xyz="0.0080749 -0.0222475 0.0085055" rpy="0 0 0" />
      <mass value="0.010" />
      <inertia ixx="4.0E-06" ixy="-5.0E-07" ixz="0"
               iyy="1.4E-06" iyz="0" izz="3.8E-06" />
    </inertial>
    <visual name="wrist_camera_vendor_bracket">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://openeta_rm75_v_description/meshes/camera_rolink.STL"
              scale="1 1 1" />
      </geometry>
      <material name="wrist_camera_aluminium"><color rgba="0.75294 0.75294 0.75294 1" /></material>
    </visual>
    <collision name="wrist_camera_vendor_bracket_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://openeta_rm75_v_description/meshes/camera_rolink.STL"
              scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <joint name="wrist_camera_bracket_joint" type="fixed">
    <!-- Use the manufacturer's terminal -X camera shoe.  Pitch the original
         arm 25 degrees toward the tool tip and seat it 20 mm proximally on
         the wrist.  The latter preserves a swept keep-out around the 220 mm
         grasped-part envelope (part radius + exact housing radius + settling
         clearance), instead of letting a released part tip into the camera.
         The longer working distance also reduces fixed gripper occlusion. -->
    <origin xyz="-0.0335 0.0085 -0.07388"
            rpy="-1.57079632679 -1.1344640138 0" />
    <parent link="link_7" />
    <child link="wrist_camera_bracket_link" />
  </joint>
