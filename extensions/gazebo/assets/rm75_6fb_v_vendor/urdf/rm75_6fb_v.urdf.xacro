  <joint name="wrist_camera_housing_joint" type="fixed">
    <!-- Seat the camera directly on the original 100.22 mm bracket datum,
         without another cantilever.  Its optical ray passes outside the
         Robotiq body and converges on the operation axis 400 mm beyond
         link_7.  Converging on the 104 mm grasp centre would point straight
         through the gripper and make fixed self-occlusion unavoidable. -->
    <origin xyz="0.029031 -0.10022 -0.0005"
            rpy="-1.55172489 0.06894605 1.40558276" />
    <parent link="wrist_camera_bracket_link" />
    <child link="wrist_camera_housing_link" />
  </joint>
  <link name="wrist_camera_optical_frame" />
  <joint name="wrist_camera_optical_joint" type="fixed">
    <!-- The vendor camera mesh occupies local z=[-0.023, 0], with its lens
         face at -Z.  Gazebo sensors look along +X, so +pi/2 about Y aligns
         the sensor ray with the physical lens face. -->
    <origin xyz="0 0 -0.0242" rpy="0 1.57079632679 0" />
    <parent link="wrist_camera_housing_link" />
    <child link="wrist_camera_optical_frame" />
  </joint>
  <gazebo reference="wrist_camera_optical_frame">
    <sensor name="openeta_wrist_rgbd" type="rgbd_camera">
      <camera>
        <!-- A moderate wide-angle field retains the target after the physical
             hinge tilt without spending pixels on the near wrist body. -->
        <horizontal_fov>1.308996938996</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>5.0</far></clip>
      </camera>
      <always_on>true</always_on>
      <!-- Preserve native 640x480 RGB-D quality while avoiding continuous
           15 Hz eye-in-hand rendering during collision-aware trajectories. -->
      <update_rate>3</update_rate>
      <topic>openeta_wrist_rgbd</topic>
      <gz_frame_id>wrist_camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>
