<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Included by the deployment-owned RM75 Jazzy description. -->
  <ros2_control name="rm75_parallel_sim" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="gripper_left_finger_joint">
      <command_interface name="position"><param name="min">0.0</param><param name="max">0.035</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right_finger_joint">
      <param name="mimic">gripper_left_finger_joint</param><param name="multiplier">1.0</param>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"/></gazebo>
</robot>
