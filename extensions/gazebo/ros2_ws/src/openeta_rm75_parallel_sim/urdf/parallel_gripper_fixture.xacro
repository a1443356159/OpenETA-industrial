<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="parallel_gripper_fixture" params="parent:=link_7">
    <!-- Every number in this macro is a simulation_fixture_parameter. -->
    <link name="gripper_mount_link">
      <inertial><origin xyz="0 0 0.015"/><mass value="0.20"/><inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00010" iyz="0" izz="0.00010"/></inertial>
      <visual><origin xyz="0 0 0.015"/><geometry><box size="0.09 0.04 0.03"/></geometry><material name="fixture_gray"><color rgba="0.35 0.35 0.38 1"/></material></visual>
      <collision><origin xyz="0 0 0.015"/><geometry><box size="0.09 0.04 0.03"/></geometry></collision>
    </link>
    <joint name="gripper_mount_joint" type="fixed"><parent link="${parent}"/><child link="gripper_mount_link"/><origin xyz="0 0 0.025" rpy="0 0 0"/></joint>

    <link name="gripper_left_finger_link">
      <inertial><origin xyz="0 0 0.070"/><mass value="0.05"/><inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000004"/></inertial>
      <visual><origin xyz="0 0 0.070"/><geometry><box size="0.012 0.016 0.070"/></geometry></visual>
      <collision><origin xyz="0 0 0.070"/><geometry><box size="0.012 0.016 0.070"/></geometry></collision>
    </link>
    <joint name="gripper_left_finger_joint" type="prismatic"><parent link="gripper_mount_link"/><child link="gripper_left_finger_link"/><origin xyz="0 0 0.04"/><axis xyz="1 0 0"/><limit lower="0.000" upper="0.035" effort="20" velocity="0.10"/></joint>

    <link name="gripper_right_finger_link">
      <inertial><origin xyz="0 0 0.070"/><mass value="0.05"/><inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000004"/></inertial>
      <visual><origin xyz="0 0 0.070"/><geometry><box size="0.012 0.016 0.070"/></geometry></visual>
      <collision><origin xyz="0 0 0.070"/><geometry><box size="0.012 0.016 0.070"/></geometry></collision>
    </link>
    <joint name="gripper_right_finger_joint" type="prismatic"><parent link="gripper_mount_link"/><child link="gripper_right_finger_link"/><origin xyz="0 0 0.04"/><axis xyz="-1 0 0"/><limit lower="0.000" upper="0.035" effort="20" velocity="0.10"/><mimic joint="gripper_left_finger_joint" multiplier="1.0" offset="0.0"/></joint>
  </xacro:macro>
</robot>
