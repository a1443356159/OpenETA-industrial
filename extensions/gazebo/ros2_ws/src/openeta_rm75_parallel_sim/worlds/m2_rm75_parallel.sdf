<?xml version="1.0"?>
<sdf version="1.10">
  <world name="m2_rm75_parallel">
    <physics name="1ms" type="ignored"><engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="ground_link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></visual></link></model>
    <!-- Top-camera pose parameters: x y z roll pitch yaw (metres/radians). -->
    <model name="openeta_top_camera"><static>true</static><pose>1.8 -1.8 1.4 0 0 2.35</pose><link name="top_camera_link"><sensor name="openeta_rgbd" type="rgbd_camera"><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10.0</far></clip></camera><always_on>true</always_on><update_rate>15</update_rate><topic>openeta_rgbd</topic><gz_frame_id>top_camera_optical_frame</gz_frame_id></sensor></link></model>
  </world>
</sdf>
