<?xml version="1.0"?>

<!--
  Operator-only Gazebo layout.  Keep the 3D viewport large and deterministic;
  qualification continues in the independent server / ROS executors.
-->
<window>
  <width>1920</width>
  <height>1080</height>
  <style
    material_theme="Dark"
    material_primary="BlueGrey"
    material_accent="LightBlue"
    toolbar_color_dark="#20252d"
    toolbar_text_color_dark="#f2f4f7"
  />
  <menus>
    <drawer default="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>OpenETA RM75 qualification view</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <graphics_api>opengl</graphics_api>
  <scene>scene</scene>
  <ambient_light>0.42 0.43 0.45 1</ambient_light>
  <background_color>0.16 0.19 0.24 1</background_color>
  <camera_pose>-1.05 -1.20 1.30 0 0.6000 0.7090</camera_pose>
  <camera_clip>
    <near>0.01</near>
    <far>20.0</far>
  </camera_clip>
  <horizontal_fov>75</horizontal_fov>
  <anti_aliasing>8</anti_aliasing>
  <view_controller>orbit</view_controller>
</plugin>

<!-- Synchronize server entities into the client render scene without loading
     the default EntityTree / inspector / shape insertion panels. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="resizable" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="resizable" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="resizable" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Deliberately omit WorldControl.  This client is observation-only: a GUI
     attaching while the native-grasp server is paused must never publish a
     play, pause, step, or reset event into the acceptance partition. -->
