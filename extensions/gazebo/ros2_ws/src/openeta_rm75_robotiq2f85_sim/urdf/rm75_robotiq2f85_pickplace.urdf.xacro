<?xml version="1.0"?>
<robot name="rm75_robotiq_2f85_pickplace_sim_v1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controller_config" default="$(find openeta_rm75_robotiq2f85_sim)/config/controllers.yaml"/>
  <xacro:include filename="$(find openeta_rm75_v_description)/urdf/rm75_6fb_v.urdf.xacro"/>
  <xacro:include filename="$(find openeta_rm75_robotiq2f85_sim)/vendor/robotiq/rm75_robotiq2f85.urdf.xacro"/>
  <xacro:include filename="$(find openeta_rm75_robotiq2f85_sim)/urdf/ros2_control.xacro"/>
  <xacro:rm75_robotiq2f85 parent="link_7" mount_z="0.0"/>
  <xacro:openeta_robotiq_ros2_control controller_config="$(arg controller_config)"/>

  <xacro:macro name="gz_gripper_position_controller" params="joint topic p_gain d_gain">
    <gazebo><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>${joint}</joint_name><topic>${topic}</topic>
      <!-- The finger-link inertias range from 1e-5 to 1e-4 kg m^2, and Gazebo updates
           at 500 Hz.  The former high derivative gain toggled the PID across
           its target every physics tick, leaving every joint at its 0.5 rad/s
           velocity limit.  This lower, proportionally damped force loop still
           rejects gravity error well inside the 0.02 rad action band while
           allowing a measured stationary terminal state. -->
      <p_gain>${p_gain}</p_gain><i_gain>0.0</i_gain><d_gain>${d_gain}</d_gain>
      <cmd_max>30.0</cmd_max><cmd_min>-30.0</cmd_min>
    </plugin></gazebo>
  </xacro:macro>
  <!-- Outer joints carry the fixed knuckle and finger bodies; the passive
       inner/tip links have roughly one order of magnitude less effective
       inertia and therefore use proportionally lower force-loop gains. -->
  <xacro:gz_gripper_position_controller joint="gripper_left_finger_joint" topic="/openeta/gripper/left_outer" p_gain="4.0" d_gain="0.04"/>
  <xacro:gz_gripper_position_controller joint="gripper_right_finger_joint" topic="/openeta/gripper/right_outer" p_gain="4.0" d_gain="0.04"/>
  <xacro:gz_gripper_position_controller joint="gripper_left_inner_knuckle_joint" topic="/openeta/gripper/left_inner" p_gain="0.5" d_gain="0.005"/>
  <xacro:gz_gripper_position_controller joint="gripper_right_inner_knuckle_joint" topic="/openeta/gripper/right_inner" p_gain="0.5" d_gain="0.005"/>
  <xacro:gz_gripper_position_controller joint="gripper_left_finger_tip_joint" topic="/openeta/gripper/left_tip" p_gain="0.5" d_gain="0.005"/>
  <xacro:gz_gripper_position_controller joint="gripper_right_finger_tip_joint" topic="/openeta/gripper/right_tip" p_gain="0.5" d_gain="0.005"/>

  <!-- These are the only grasp-admission inputs: native Gazebo contact data
       from the real vendor fingertip collision meshes. -->
  <gazebo reference="robotiq_85_left_finger_tip_link">
    <sensor name="openeta_native_grasp_left_pad_contact" type="contact">
      <!-- 125 Hz retains at least twelve samples in the 100 ms bilateral proof
           window, four times the three-sample gate, while avoiding needless
           contact serialization during every arm trajectory. -->
      <always_on>true</always_on><update_rate>125</update_rate>
      <topic>/openeta/native_grasp/contacts/left_pad</topic>
      <contact><collision>robotiq_85_left_finger_tip_link_collision</collision></contact>
    </sensor>
  </gazebo>
  <gazebo reference="robotiq_85_right_finger_tip_link">
    <sensor name="openeta_native_grasp_right_pad_contact" type="contact">
      <always_on>true</always_on><update_rate>125</update_rate>
      <topic>/openeta/native_grasp/contacts/right_pad</topic>
      <contact><collision>robotiq_85_right_finger_tip_link_collision</collision></contact>
    </sensor>
  </gazebo>
  <gazebo reference="rm75_to_gripper_mount"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

  <!-- Stock Gazebo Sim 8 fixed joint.  It is initially attached by Gazebo;
       runtime preflight always obtains a detached ACK while the world is paused. -->
  <gazebo><plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
    <parent_link>gripper_mount_link</parent_link>
    <child_model>target_object</child_model><child_link>target_link</child_link>
    <attach_topic>/openeta/native_grasp/detachable_joint/target/attach</attach_topic>
    <detach_topic>/openeta/native_grasp/detachable_joint/target/detach</detach_topic>
    <output_topic>/openeta/native_grasp/detachable_joint/target/state</output_topic>
    <suppress_child_warning>true</suppress_child_warning>
  </plugin></gazebo>
</robot>
