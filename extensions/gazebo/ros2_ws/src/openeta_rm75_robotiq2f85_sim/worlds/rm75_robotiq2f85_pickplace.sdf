<?xml version="1.0"?>
<sdf version="1.10">
  <world name="rm75_robotiq2f85_pickplace">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <!-- A low-contrast key plus ambient fill preserves link curvature in the
         operator view without casting distracting shadows into RGB-D input. -->
    <scene>
      <ambient>0.42 0.43 0.45 1</ambient>
      <background>0.16 0.19 0.24 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="soft_key_light" type="directional">
      <pose>0 0 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.78 0.76 0.72 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>
    <model name="industrial_floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision"><geometry><box><size>10 10 0.02</size></box></geometry></collision>
        <visual name="floor_visual">
          <!-- Keep the collision surface at z=0 while rendering the black
               surface 1 mm above Gazebo's client grid to avoid z-fighting. -->
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>10 10 0.02</size></box></geometry>
          <material>
            <ambient>0.015 0.018 0.025 1</ambient>
            <diffuse>0.025 0.030 0.040 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="work_table"><static>true</static><pose>0.40 0 0.38 0 0 0</pose><link name="table_link"><collision name="table_collision"><geometry><box><size>0.70 0.60 0.04</size></box></geometry></collision><visual name="table_visual"><geometry><box><size>0.70 0.60 0.04</size></box></geometry><material><ambient>0.58 0.60 0.64 1</ambient><diffuse>0.70 0.72 0.76 1</diffuse><specular>0.08 0.08 0.08 1</specular></material></visual></link></model>
    <model name="placement_zone_marker"><static>true</static><pose>0.48 -0.10 0.4005 0 0 0</pose><link name="marker_link"><visual name="marker_visual"><geometry><box><size>0.12 0.12 0.001</size></box></geometry><material><ambient>0.05 0.55 0.10 0.8</ambient><diffuse>0.05 0.75 0.15 0.8</diffuse></material></visual></link></model>

    <model name="target_object">
      <pose>0.28 -0.10 0.43 0 0 0</pose>
      <link name="target_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0000433333</ixx><iyy>0.0000433333</iyy><izz>0.0000266667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="target_collision"><geometry><box><size>0.04 0.04 0.06</size></box></geometry></collision>
        <visual name="target_visual"><geometry><box><size>0.04 0.04 0.06</size></box></geometry><material><ambient>0.80 0.12 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual>
      </link>
    </model>
    <model name="distractor_object">
      <pose>0.28 0.12 0.44 0 0 0</pose>
      <link name="distractor_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.0000715</ixx><iyy>0.0000715</iyy><izz>0.0000375</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="distractor_collision"><geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="distractor_visual"><geometry><cylinder><radius>0.025</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.20 0.75 1</ambient><diffuse>0.10 0.28 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Center the independent placement view over the work surface so the
         attached object and the complete placement marker remain observable. -->
    <model name="openeta_top_camera"><static>true</static><pose>0.35 0 1.30 0 1.5707963 0</pose><link name="top_camera_link"><sensor name="openeta_rgbd" type="rgbd_camera"><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10.0</far></clip></camera><always_on>true</always_on><update_rate>15</update_rate><topic>openeta_rgbd</topic><gz_frame_id>top_camera_optical_frame</gz_frame_id></sensor></link></model>
  </world>
</sdf>
