OPENETA_LLM_PROVIDER=openai-compatible
OPENETA_LLM_ENABLE_VISION=true
OPENETA_LLM_MODEL=
OPENETA_LLM_API_BASE=
OPENETA_LLM_API_KEY=
OPENETA_LLM_TIMEOUT_S=60
OPENETA_LLM_MAX_ATTEMPTS=3
OPENETA_LLM_MAX_TOKENS=512
OPENETA_LLM_RETRY_BACKOFF_S=0.5
OPENETA_LLM_FALLBACK_PROVIDER=
OPENETA_LLM_FALLBACK_MODEL=
OPENETA_LLM_FALLBACK_API_BASE=
OPENETA_LLM_FALLBACK_API_KEY=
OPENETA_LLM_FALLBACK_TIMEOUT_S=60
# Configure both values together. Deployment guide:
# https://github.com/Huaizz-shawen/object-memory-bank
OPENETA_OBJECT_MEMORY_BANK_URL=
OPENETA_OBJECT_MEMORY_BANK_API_KEY=
OPENETA_WEB_SEARCH_ENABLED=false
OPENETA_WEB_FETCH_ENABLED=false
# Host-owned grasp routing: auto, anygrasp, or graspgenx. Concrete values are
# strict and do not silently fall back to another configured backend.
OPENETA_GRASP_BACKEND=auto
# Candidate services return host-only reserve pools. Every bounded full-plan
# PASS becomes a selectable candidate; there is no second exposure limit.
OPENETA_GRASPGENX_RAW_POOL_SIZE=200
OPENETA_ANYGRASP_RAW_POOL_SIZE=200
OPENETA_ANYPLACE_RAW_POOL_SIZE=96
OPENETA_GRASP_DIVERSITY_POOL_SIZE=64
OPENETA_ANYPLACE_DIVERSITY_POOL_SIZE=96
OPENETA_GRASP_FULL_PLAN_LIMIT=2
OPENETA_ANYPLACE_FULL_PLAN_LIMIT=2
OPENETA_PREGRASP_JOINT_GRASP_BRANCH_LIMIT=4
OPENETA_PREGRASP_JOINT_FULL_PLAN_LIMIT=2
OPENETA_MOVEIT_IK_SEED_COUNT=8
OPENETA_ANYPLACE_MAX_QUALIFICATION_ROUNDS=2
