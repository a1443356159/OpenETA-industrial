# shellcheck shell=bash
# Source this file from any checkout location. It intentionally derives every
# repository path from this file instead of embedding a developer workstation.
_OPENETA_RUNTIME_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export OPENETA_REPO_ROOT="$(cd -- "${_OPENETA_RUNTIME_DIR}/../.." && pwd)"
unset _OPENETA_RUNTIME_DIR

export ROS_DISTRO="${ROS_DISTRO:-jazzy}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
export OPENETA_GAZEBO_ROS2_EXECUTABLE="${OPENETA_GAZEBO_ROS2_EXECUTABLE:-ros2}"
export OPENETA_GAZEBO_GZ_EXECUTABLE="${OPENETA_GAZEBO_GZ_EXECUTABLE:-gz}"
export OPENETA_GAZEBO_LAUNCH_PACKAGE="${OPENETA_GAZEBO_LAUNCH_PACKAGE:-openeta_rm75_robotiq2f85_sim}"
export OPENETA_GAZEBO_LAUNCH_FILE="${OPENETA_GAZEBO_LAUNCH_FILE:-m2_gazebo_moveit.launch.py}"
export OPENETA_GAZEBO_WORLD="${OPENETA_GAZEBO_WORLD:-m2_rm75_robotiq2f85}"
export OPENETA_MCP_PORT="${OPENETA_MCP_PORT:-8765}"
export OPENETA_GAZEBO_ASSET_ROOT="${OPENETA_REPO_ROOT}/extensions/gazebo/assets"
export OPENETA_GAZEBO_ROS2_WS="${OPENETA_REPO_ROOT}/extensions/gazebo/ros2_ws"
export OPENETA_MODEL_CACHE="${OPENETA_REPO_ROOT}/.cache/models"
export ROS_HOME="${OPENETA_REPO_ROOT}/.cache/ros"

# Headless is the portable default. Users with a desktop may override these
# before sourcing this file.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
export GZ_SIM_RENDER_ENGINE_SERVER="${GZ_SIM_RENDER_ENGINE_SERVER:-ogre2}"
